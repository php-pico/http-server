{
    "name"        : "php-pico/http-server",
    "description" : "A PSR-15 compliant HTTP server package.",
    "type"        : "library",
    "license"     : "MIT",
    "minimum-stability": "stable",
    "scripts"     : {
        "format": "mago format",
        "mago": "mago analyze",
        "test": "phpunit -c phpunit.xml.dist",
        "qa": [
            "@format",
            "@mago",
            "@test"
        ]
    },
    "require"     : {
        "php": "^8.5",
        "psr/http-server-middleware": "^1.0.2",
        "psr/http-server-handler": "^1.0.2",
        "php-pico/http-message": "^0.1.3"
    },
    "autoload"    : {
        "psr-4": {
            "PhpPico\\Http\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpPico\\Http\\Server\\Tests\\": "tests/"
        }
    },
    "require-dev" : {
        "carthage-software/mago": "^1.43.0",
        "phpunit/phpunit": "^12.5.31"
    },
    "config"      : {
        "allow-plugins": {
            "carthage-software/mago": true
        }
    }
}
